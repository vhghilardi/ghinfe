# Redis (Bull queue)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=

# API de testes / Swagger
PORT=3333

# SEFAZ (produção — use com cuidado)
# SEFAZ_MOCK=true
# SEFAZ_ENDPOINT=https://homologacao.nfe.fazenda.sp.gov.br/ws/nfeautorizacao4.asmx

# Certificado A1
# PFX_PATH=./certs/certificado.pfx
# PFX_PASSWORD=

# DC-e em homologação (examples/dce-homologacao.js) — PFX ou par PEM
# DCE_PFX=./cert/certificado.pfx
# DCE_PFX_SENHA=
# DCE_CERT_PEM=./cert/cert.pem
# DCE_KEY_PEM=./cert/key.pem
# DCE_TIPO_EMITENTE=marketplace
# DCE_MARKETPLACE_SITE=www.exemplo.com.br
# DCE_EMIT_ENDERECO={"logradouro":"...","numero":"...","bairro":"...","codigoMunicipio":"...","municipio":"...","uf":"..","cep":"..."}
